{
  "Service": {
    "RefreshIntervalMinutes": 60,
    "RefreshOnStartup": true
  },
  "Browser": {
    "Channel": "chrome",
    "ExecutablePath": null
  },
  "Logging": {
    "Console": {
      "Enabled": true
    },
    "File": {
      "Enabled": false,
      "Path": "logs/m3uproxy.log",
      "MaxFileSizeBytes": 10485760,
      "RetainedFileCount": 7
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "None"
    }
  },
  "downloads": [
    {
      "name": "My playlist #1",
      "url": "",
      "filePath": ""
    },
    {
      "name": "My playlist #2",
      "url": "",
      "filePath": ""
    }
  ],
  "proxy": {
    "listenUrl": "http://127.0.0.1:5050",
    "publicBaseUrl": "http://127.0.0.1:5050",
    "serveDownloadedFiles": true,
    "downloadMaxAgeMinutes": 60,
    "sources": [
      {
        "name": "Provider #1",
        "playlistDownload": "Provider 1 playlist",
        "epgDownload": "Provider 1 EPG"
      },
      {
        "name": "Provider 2",
        "playlistDownload": "Provider 2 playlist",
        "epgDownload": "Provider 2 EPG"
      }
    ]
  }
}
